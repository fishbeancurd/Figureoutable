{
  "expo": {
    "name": "Pawgress",
    "slug": "pawgress",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pawgress",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F0FB",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "bundleIdentifier": "com.pawgress.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Pawgress uses the camera so you can snap a food, toy or symptom and ask about it, and to take your dog's profile photo.",
        "NSPhotoLibraryUsageDescription": "Pawgress lets you pick photos to ask about or to use as your dog's profile picture."
      }
    },
    "android": {
      "package": "com.pawgress.app",
      "adaptiveIcon": {
        "backgroundColor": "#E1D9F7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F0FB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pawgress lets you pick photos to ask about or to use as your dog's profile picture.",
          "cameraPermission": "Pawgress uses the camera so you can snap a food, toy or symptom and ask about it."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF9C74"
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7b581e7c-38c9-4d4e-9830-55c5f4a940c6"
      }
    },
    "owner": "fishbeancurd",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7b581e7c-38c9-4d4e-9830-55c5f4a940c6"
    }
  }
}
